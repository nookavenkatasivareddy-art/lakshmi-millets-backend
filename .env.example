PORT=5000
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:4200

# --- MongoDB ---
# Local install:
# MONGODB_URI=mongodb://127.0.0.1:27017/lakshmi_millets
#
# MongoDB Atlas (cloud, free tier) — replace <user>, <password>, <cluster-url>:
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/lakshmi_millets?retryWrites=true&w=majority
